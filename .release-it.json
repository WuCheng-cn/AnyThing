{
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "gitmoji-config",
      "infile": "CHANGELOG.md"
    }
  },
  "git": {
    "commitMessage": ":rocket: chore(release): Release v${version}"
  },
  "github": {
    "release": true,
    "draft": false
  },
  "npm": {
    "publish": true
  }
}
